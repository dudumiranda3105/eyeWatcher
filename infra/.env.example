# ============================================================================
# eyeWatcher — variáveis do docker-compose de infra/
# ----------------------------------------------------------------------------
# Copie este arquivo para infra/.env e ajuste os valores:
#
#   Git Bash:   cp infra/.env.example infra/.env
#   PowerShell: Copy-Item infra\.env.example infra\.env
#
# NUNCA versione o infra/.env (ele contém senha e token).
# ============================================================================

# --- Credenciais do usuário administrador inicial do InfluxDB ---------------
# Usadas só no primeiro boot do container (DOCKER_INFLUXDB_INIT_MODE=setup)
# e para entrar na UI em http://localhost:8086
INFLUXDB_USERNAME=eyewatcher
# Mínimo de 8 caracteres — o InfluxDB recusa senhas menores. TROQUE ESTE VALOR.
INFLUXDB_PASSWORD=troque-esta-senha

# --- Organização / bucket / retenção (fixados por docs/CONTRACT.md) ---------
# Não altere: o backend e o frontend dependem exatamente destes nomes.
INFLUXDB_ORG=eyewatcher
INFLUXDB_BUCKET=rack_metrics
INFLUXDB_RETENTION=30d

# --- Token admin fixo -------------------------------------------------------
# Este é o valor que deve ser copiado para INFLUX_TOKEN no backend/.env.
# É "fixo" de propósito: assim o backend não precisa ser reconfigurado toda
# vez que o container é recriado.
#
# Para gerar um token novo e aleatório:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#   Git Bash:   openssl rand -base64 48
INFLUXDB_ADMIN_TOKEN=troque-este-token-por-uma-string-longa-e-aleatoria
