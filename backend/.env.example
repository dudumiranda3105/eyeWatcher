# ============================================================
# eyeWatcher — configuracao do backend
# Copie este arquivo para `.env` e ajuste os valores.
#   cp .env.example .env      (bash)
#   copy .env.example .env    (cmd)
# NUNCA versione o `.env` com o token real do InfluxDB.
# ============================================================

# ---------- MQTT (Mosquitto) ----------
# Host do broker MQTT.
MQTT_HOST=localhost
# Porta TCP do broker (a porta 9001 e WebSocket, usada pelo frontend, nao pelo backend).
MQTT_PORT=1883
# Prefixo base dos topicos. O backend assina <MQTT_TOPIC>/+/telemetry e <MQTT_TOPIC>/+/status.
MQTT_TOPIC=eyewatcher
# Overrides opcionais dos filtros de assinatura (deixe em branco para derivar de MQTT_TOPIC).
# `scripts\setup-influx.ps1` gera o .env ja com estas duas chaves.
MQTT_TOPIC_TELEMETRY=eyewatcher/+/telemetry
MQTT_TOPIC_STATUS=eyewatcher/+/status
# Client ID do backend no broker (precisa ser unico no broker).
MQTT_CLIENT_ID=eyewatcher-backend
# Keepalive MQTT em segundos.
MQTT_KEEPALIVE=60
# QoS usado nas assinaturas (o contrato define 1).
MQTT_QOS=1
# Credenciais do broker (deixe em branco se o Mosquitto estiver com allow_anonymous true).
MQTT_USERNAME=
MQTT_PASSWORD=

# ---------- InfluxDB 2.x ----------
INFLUX_URL=http://localhost:8086
# Token de API com permissao de leitura/escrita no bucket. Gere no InfluxDB e cole aqui.
INFLUX_TOKEN=troque-pelo-seu-token
INFLUX_ORG=eyewatcher
INFLUX_BUCKET=rack_metrics
# Tamanho do lote de escrita (pontos) e intervalo de flush (ms) do batching.
INFLUX_BATCH_SIZE=50
INFLUX_FLUSH_INTERVAL_MS=2000
# Intervalo (s) entre tentativas de reconexao/ping quando o InfluxDB esta fora.
INFLUX_HEALTHCHECK_INTERVAL_S=15

# ---------- Limiares (identicos ao firmware) ----------
# temperatura: ok < 30 | warning 30-34.9 | critical >= 35
TEMP_WARN=30
TEMP_CRIT=35
# umidade: ok 30-70 | warning 20-29.9 ou 70.1-80 | critical < 20 ou > 80
HUM_MIN_WARN=30
HUM_MIN_CRIT=20
HUM_MAX_WARN=70
HUM_MAX_CRIT=80

# ---------- API HTTP ----------
API_HOST=0.0.0.0
API_PORT=8000
# Origens liberadas no CORS, separadas por virgula. Use * para liberar tudo (apenas em dev).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Logging ----------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
